#include <iostream>
using namespace std;

class Complex {
private:
    float real, imag;

public:
    void accept() {
        cout << "Enter real part: ";
        cin >> real;
        cout << "Enter imaginary part: ";
        cin >> imag;
    }

    void display() const {
        if (imag >= 0)
            cout << real << " + " << imag << "i";
        else
            cout << real << " - " << -imag << "i";
        cout << endl;
    }

    Complex add(Complex c) const {
        Complex t;
        t.real = real + c.real;
        t.imag = imag + c.imag;
        return t;
    }

    Complex subtract(Complex c) const {
        Complex t;
        t.real = real - c.real;
        t.imag = imag - c.imag;
        return t;
    }

    Complex multiply(Complex c) const {
        Complex t;
        t.real = real * c.real - imag * c.imag;
        t.imag = real * c.imag + imag * c.real;
        return t;
    }

    Complex divide(Complex c) const {
        Complex t;
        float denominator = c.real * c.real + c.imag * c.imag;
        if (denominator == 0)
            throw "Cannot divide by zero complex number!";
        t.real = (real * c.real + imag * c.imag) / denominator;
        t.imag = (imag * c.real - real * c.imag) / denominator;
        return t;
    }

    Complex conjugate() const {
        Complex t;
        t.real = real;
        t.imag = -imag;
        return t;
    }
};

int main() {
    Complex c1, c2, result;

    try {
        cout << "Enter first complex number:\n";
        c1.accept();

        cout << "\nEnter second complex number:\n";
        c2.accept();

        result = c1.add(c2);
        cout << "\nAddition: ";
        result.display();

        result = c1.subtract(c2);
        cout << "Subtraction: ";
        result.display();

        result = c1.multiply(c2);
        cout << "Multiplication: ";
        result.display();

        result = c1.divide(c2);
        cout << "Division: ";
        result.display();

        result = c1.conjugate();
        cout << "Conjugate of first number: ";
        result.display();
    }
    catch (const char* msg) {
        cout << "Exception: " << msg << endl;
    }

    return 0;
}
