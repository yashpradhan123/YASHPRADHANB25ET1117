#include <iostream>
using namespace std;
void read(int a[], int n) {
	cout << "Enter " << n << " numbers:\n";
	for (int i = 0; i < n; i++)
		cin >> a[i];
}
void display(int a[], int n) {
	for (int i = 0; i < n; i++)
		cout << a[i] << " ";
	cout << endl;
}
void swapNumbers(int &x, int &y) {
	int temp = x;
	x = y;
	y = temp;
}
void sortArray(int a[], int n) {
	for (int i = 0; i < n - 1; i++) {
		for (int j = 0; j < n - i - 1; j++) {
			if (a[j] > a[j + 1])
				swapNumbers(a[j], a[j + 1]);
		}
	}
}
int main() {
	int n, a[100];
	cout << "Enter size of array: ";
	cin >> n;
	read(a, n);
	cout << "Original array: ";
	display(a, n);
	sortArray(a, n);
	cout << "Sorted array: ";
	display(a, n);
	return 0;
}
